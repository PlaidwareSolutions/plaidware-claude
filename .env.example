DATABASE_URL=postgres://localhost:5432/plaidware_hub
BETTER_AUTH_SECRET=            # 32+ bytes, e.g. `openssl rand -base64 32`
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Plaidware <no-reply@contact.plaidware.com>
OPS_EMAIL=
STRIPE_SECRET_KEY=             # sk_test_... in dev/staging; live only in production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
