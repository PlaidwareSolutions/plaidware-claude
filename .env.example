# Copy to .env and fill in. All server-side unless prefixed NEXT_PUBLIC_.
DATABASE_URL=postgres://localhost:5432/plaidware_hub
BETTER_AUTH_SECRET=            # 32+ bytes, e.g. `openssl rand -base64 32`
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Plaidware <no-reply@contact.plaidware.com>
OPS_EMAIL=
STRIPE_SECRET_KEY=             # sk_test_... in dev/staging; live only in production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# MHub integration (marketing.plaidware.com) — all optional; without them,
# lifecycle deliveries queue in webhook_deliveries until the worker can send.
# COOKIE_DOMAIN=               # ".plaidware.com" in deployed envs; unset locally (host-only cookies)
# MHUB_BASE_URL=               # e.g. https://mhub-staging.plaidware.com (provisioning handshake target)
# MHUB_LIFECYCLE_URL=          # e.g. https://mhub-staging.plaidware.com/api/hub/lifecycle
# MHUB_WEBHOOK_SECRET=         # shared HMAC secret, 16+ chars; must match MHub

# Later milestones:
# CREDENTIALS_ENCRYPTION_KEY=  # 32 bytes base64 (M6)
# PAGESPEED_INSIGHTS_API_KEY=  # (M8)
# RAILWAY_API_TOKEN=           # (M10)
